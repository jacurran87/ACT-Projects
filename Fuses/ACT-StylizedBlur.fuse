            WeightSum += Weight;
        }

        if (WeightSum > 0.0f) {
            SumColor.x /= WeightSum;
            SumColor.y /= WeightSum;
            SumColor.z /= WeightSum;
        } else {
            SumColor = CenterColor;
        }

        SumColor.w = CenterColor.w;
        _tex2DVec4Write(Destination, x, y, SumColor);
    }
]]

ACTLogo = [[
    <center><img width="300" src='data:image/png;base64, '></center>
]]

local VersionUI = string.format([[
    <center><b>%s v%s</b></center>
]], FuseName, FuseVersion)

local DescriptionUI = string.format([[
    <h3 style="line-height: 0.5;" >ACT %s</h3>
    <p>Version %s | By %s</p>
    <p>%s</p>
    <br>
]], FuseName, FuseVersion, FuseAuthor, FuseDescription)

InEnableColor = {}
InRed = {}
InGreen = {}
InBlue = {}

function NotifyChanged(inp, param)
    if inp ~= nil and param ~= nil then
        if inp == InNumberofColors then
            local NumColorsValue = param.Value

            for i = 1, 100 do
                local IsVisible = (i <= NumColorsValue)

                InEnableColor[i]:SetAttrs({ IC_Visible = IsVisible })
                InRed[i]:SetAttrs({ IC_Visible = IsVisible })
                InGreen[i]:SetAttrs({ IC_Visible = IsVisible })
                InBlue[i]:SetAttrs({ IC_Visible = IsVisible })
            end
        end
    end
end

function Create()
    InImage = self:AddInput("Image", "Input", {
        LINKID_DataType = "Image",
        LINK_Main       = 1,
    })

    InBlurMap = self:AddInput("Blur Map", "BlurMap", {
        LINKID_DataType = "Image",
        LINK_Main       = 2,
        INP_Required    = false,
    })

    InLogo = self:AddInput(ACTLogo, "Logo", {
        LINKID_DataType    = "Text",
        INPID_InputControl = "LabelControl",
        INP_External       = false,
        INP_Passive        = true,
        IC_ControlPage     = -1,
        IC_NoLabel         = true,
        IC_NoReset         = true,
        LBLC_MultiLine     = true,
    })

    InVersion = self:AddInput(VersionUI, "Version", {
        LINKID_DataType    = "Text",
        INPID_InputControl = "LabelControl",
        INP_External       = false,
        INP_Passive        = true,
        IC_ControlPage     = -1,
        IC_NoLabel         = true,
        IC_NoReset         = true,
        LBLC_MultiLine     = true,
    })

    InBlurSize = self:AddInput("Max Blur Size", "BlurSize", {
        LINKID_DataType    = "Number",
        INPID_InputControl = "SliderControl",
        INP_Integer        = true,
        INP_Default        = 10.0,
        INP_MinAllowed     = 0.0,
        INP_MaxScale       = 100.0,
    })

    InTolerance = self:AddInput("Tolerance", "Tolerance", {
        LINKID_DataType    = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default        = 0.0,
        INP_MinAllowed     = 0.0,
        INP_MaxAllowed     = 1.0,
    })

    InNumberofColors = self:AddInput("Number of Colors", "NumberofColors", {
        LINKID_DataType     = "Number",
        INPID_InputControl  = "SliderControl",
        INP_Integer         = true,
        INP_Default         = 10.0,
        INP_MinAllowed      = 1.0,
        INP_MaxAllowed      = 100.0,
        INP_DoNotifyChanged = true,
    })

    self:BeginControlNest("Colors", "ColorsNest", true, {})

    for i = 1, 100 do
        InEnableColor[i] = self:AddInput("Enable Color " .. i, "EnableColor" .. i, {
            LINKID_DataType    = "Number",
            INPID_InputControl = "CheckboxControl",
            INP_Integer        = true,
            INP_Default        = 0.0,
            IC_Visible         = false,
        })

        InRed[i] = self:AddInput("Red " .. i, "Red" .. i, {
            ICS_Name           = "Color " .. i,
            LINKID_DataType    = "Number",
            INPID_InputControl = "ColorControl",
            INP_Default        = 0.0,
            INP_MaxScale       = 1.0,
            CLRC_ShowWheel     = false,
            IC_ControlGroup    = i,
            IC_ControlID       = 0,
            IC_Visible         = false,
        })

        InGreen[i] = self:AddInput("Green " .. i, "Green" .. i, {
            LINKID_DataType    = "Number",
            INPID_InputControl = "ColorControl",
            INP_Default        = 0.0,
            IC_ControlGroup    = i,
            IC_ControlID       = 1,
            IC_Visible         = false,
        })

        InBlue[i] = self:AddInput("Blue " .. i, "Blue" .. i, {
            LINKID_DataType    = "Number",
            INPID_InputControl = "ColorControl",
            INP_Default        = 0.0,
            IC_ControlGroup    = i,
            IC_ControlID       = 2,
            IC_Visible         = false,
        })
    end

    self:EndControlNest()

    self:AddControlPage("Info")

    InDescription = self:AddInput(DescriptionUI, "Description", {
        LINKID_DataType    = "Text",
        INPID_InputControl = "LabelControl",
        INP_External       = false,
        INP_Passive        = true,
        IC_NoLabel         = true,
        IC_NoReset         = true,
        LBLC_MultiLine     = true,
    })

    InRepository = self:AddInput("ACT Projects Repository", "ACTRepository", {
        LINKID_DataType    = "Number",
        INPID_InputControl = "ButtonControl",
        ICD_Width          = 0.5,
        IC_NoLabel         = true,
        IC_NoReset         = true,
        BTNCS_Execute      = [=[
            local url = "https://github.com/AbiYasidAlMajid/ACT-Projects"
            bmd.openurl(url)
        ]=],
    })

    InSocials = self:AddInput("Socials", "Socials", {
        LINKID_DataType    = "Number",
        INPID_InputControl = "ButtonControl",
        ICD_Width          = 0.5,
        IC_NoLabel         = true,
        IC_NoReset         = true,
        BTNCS_Execute      = [=[
            local url = "https://linktr.ee/abiyasidalmajid"
            bmd.openurl(url)
        ]=],
    })

    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image",
        LINK_Main       = 1,
    })
end

function Process(req)
    local SourceImage = InImage:GetValue(req)
    if SourceImage == nil then return end

    local BlurMapImage = InBlurMap:GetValue(req)
    local BlurSizeValue = InBlurSize:GetValue(req).Value
    local ToleranceValue = InTolerance:GetValue(req).Value
    local NumColorsValue = InNumberofColors:GetValue(req).Value

    local ActiveCount = 0
    local ActiveColors = {}

    for i = 1, NumColorsValue do
        local IsEnabled = InEnableColor[i]:GetValue(req).Value

        if IsEnabled == 1.0 then
            local R = InRed[i]:GetValue(req).Value
            local G = InGreen[i]:GetValue(req).Value
            local B = InBlue[i]:GetValue(req).Value

            table.insert(ActiveColors, { R, G, B })
            ActiveCount = ActiveCount + 1
        end
    end

    if ActiveCount == 0 or BlurSizeValue < 1 then
        OutImage:Set(req, SourceImage)
        return
    end

    local ImageWidth = SourceImage.DataWindow:Width()
    local ImageHeight = SourceImage.DataWindow:Height()

    -- PASS 1: Mask
    local MaskImage = Image({ IMG_Like = SourceImage })
    local NodeMask = DVIPComputeNode(req, "ACTStBl_MaskKernel", ACTStBl_MaskKernelSource, "ACTStBl_MaskParams", ACTStBl_MaskParams)

    if NodeMask == nil then
        OutImage:Set(req, SourceImage)
        return
    end

    do
        local ParamBlock = NodeMask:GetParamBlock(ACTStBl_MaskParams)
        ParamBlock.Tolerance = ToleranceValue
        ParamBlock.NumColors = ActiveCount
        ParamBlock.SrcSize[0] = ImageWidth
        ParamBlock.SrcSize[1] = ImageHeight

        for i, Color in ipairs(ActiveColors) do
            local Idx                  = (i - 1) * 3
            ParamBlock.Colors[Idx]     = Color[1]
            ParamBlock.Colors[Idx + 1] = Color[2]
            ParamBlock.Colors[Idx + 2] = Color[3]
        end

        NodeMask:SetParamBlock(ParamBlock)
        NodeMask:AddInput("SourceImage", SourceImage)
        NodeMask:AddOutput("Destination", MaskImage)
        NodeMask:RunSession(req)
    end

    -- PASS 2: JFA Initialization
    local SeedImage = Image({ IMG_Like = SourceImage })
    local NodeInit = DVIPComputeNode(req, "ACTStBl_JFAInitKernel", ACTStBl_JFAInitSource, "ACTStBl_SimpleParams", ACTStBl_SimpleParams)

    if NodeInit ~= nil then
        local ParamBlock = NodeInit:GetParamBlock(ACTStBl_SimpleParams)
        ParamBlock.SrcSize[0] = ImageWidth
        ParamBlock.SrcSize[1] = ImageHeight

        NodeInit:SetParamBlock(ParamBlock)
        NodeInit:AddInput("Mask", MaskImage)
        NodeInit:AddOutput("Destination", SeedImage)
        NodeInit:RunSession(req)
    end

    -- PASS 3: JFA Propagation (Ping-Pong)
    local StartStep = 1

    while StartStep < BlurSizeValue do
        StartStep = StartStep * 2
    end

    local StepsList = {}
    local CurrentStep = StartStep

    while CurrentStep >= 1 do
        table.insert(StepsList, CurrentStep)
        CurrentStep = math.floor(CurrentStep / 2)
    end

    table.insert(StepsList, 1)
    table.insert(StepsList, 1)

    for _, StepValue in ipairs(StepsList) do
        local NextSeed = Image({ IMG_Like = SourceImage })
        local NodeStep = DVIPComputeNode(req, "ACTStBl_JFAStepKernel", ACTStBl_JFAStepSource, "ACTStBl_StepParams", ACTStBl_StepParams)

        if NodeStep ~= nil then
            local ParamBlock = NodeStep:GetParamBlock(ACTStBl_StepParams)
            ParamBlock.SrcSize[0] = ImageWidth
            ParamBlock.SrcSize[1] = ImageHeight
            ParamBlock.Step = StepValue

            NodeStep:SetParamBlock(ParamBlock)
            NodeStep:AddInput("SeedImage", SeedImage)
            NodeStep:AddOutput("Destination", NextSeed)
            NodeStep:RunSession(req)
        end

        SeedImage = NextSeed
    end

    -- PASS 4: Distance Field (+ Blur Map)
    local DistanceImage = Image({ IMG_Like = SourceImage })
    local NodeDistance

    if BlurMapImage ~= nil then
        NodeDistance = DVIPComputeNode(req, "ACTStBl_DistanceKernelBM", ACTStBl_DistanceBMSource, "ACTStBl_SimpleParams", ACTStBl_SimpleParams)
    else
        NodeDistance = DVIPComputeNode(req, "ACTStBl_DistanceKernel", ACTStBl_DistanceSource, "ACTStBl_SimpleParams", ACTStBl_SimpleParams)
    end

    if NodeDistance ~= nil then
        local ParamBlock = NodeDistance:GetParamBlock(ACTStBl_SimpleParams)
        ParamBlock.SrcSize[0] = ImageWidth
        ParamBlock.SrcSize[1] = ImageHeight

        NodeDistance:SetParamBlock(ParamBlock)
        NodeDistance:AddInput("SeedImage", SeedImage)
        NodeDistance:AddInput("Mask", MaskImage)

        if BlurMapImage ~= nil then
            NodeDistance:AddInput("BlurMapImage", BlurMapImage)
        end

        NodeDistance:AddOutput("Destination", DistanceImage)
        NodeDistance:RunSession(req)
    end

    -- PASS 5: Horizontal Blur
    local BlurHorizontal = Image({ IMG_Like = SourceImage })
    local NodeBlurH

    if BlurMapImage ~= nil then
        NodeBlurH = DVIPComputeNode(req, "ACTStBl_BlurHKernelBM", ACTStBl_BlurHBMSource, "ACTStBl_BlurPassParams", ACTStBl_BlurPassParams)
    else
        NodeBlurH = DVIPComputeNode(req, "ACTStBl_BlurHKernel", ACTStBl_BlurHSource, "ACTStBl_BlurPassParams", ACTStBl_BlurPassParams)
    end

    if NodeBlurH ~= nil then
        local ParamBlock = NodeBlurH:GetParamBlock(ACTStBl_BlurPassParams)
        ParamBlock.SrcSize[0] = ImageWidth
        ParamBlock.SrcSize[1] = ImageHeight
        ParamBlock.BlurSize = BlurSizeValue

        NodeBlurH:SetParamBlock(ParamBlock)
        NodeBlurH:AddInput("SourceImage", SourceImage)
        NodeBlurH:AddInput("DistTexture", DistanceImage)

        if BlurMapImage ~= nil then
            NodeBlurH:AddInput("BlurMapImage", BlurMapImage)
        end

        NodeBlurH:AddOutput("Destination", BlurHorizontal)
        NodeBlurH:RunSession(req)
    end

    -- PASS 6: Vertical Blur
    local DestinationImage = Image({ IMG_Like = SourceImage })
    local NodeBlurV

    if BlurMapImage ~= nil then
        NodeBlurV = DVIPComputeNode(req, "ACTStBl_BlurVKernelBM", ACTStBl_BlurVBMSource, "ACTStBl_BlurPassParams", ACTStBl_BlurPassParams)
    else
        NodeBlurV = DVIPComputeNode(req, "ACTStBl_BlurVKernel", ACTStBl_BlurVSource, "ACTStBl_BlurPassParams", ACTStBl_BlurPassParams)
    end

    if NodeBlurV ~= nil then
        local ParamBlock = NodeBlurV:GetParamBlock(ACTStBl_BlurPassParams)
        ParamBlock.SrcSize[0] = ImageWidth
        ParamBlock.SrcSize[1] = ImageHeight
        ParamBlock.BlurSize = BlurSizeValue

        NodeBlurV:SetParamBlock(ParamBlock)
        NodeBlurV:AddInput("SourceImage", BlurHorizontal)
        NodeBlurV:AddInput("DistTexture", DistanceImage)

        if BlurMapImage ~= nil then
            NodeBlurV:AddInput("BlurMapImage", BlurMapImage)
        end

        NodeBlurV:AddOutput("Destination", DestinationImage)
        NodeBlurV:RunSession(req)
    end

    OutImage:Set(req, DestinationImage)
end