            float4 SampleColor = _tex2DVecN(SourceImage, x, SampleY, 15);

            float BlurMapWeight = _tex2DVecN(BlurMapImage, x, SampleY, 1).x;
            BlurMapWeight = BlurMapWeight < 0.0f ? 0.0f : (BlurMapWeight > 1.0f ? 1.0f : BlurMapWeight);

            float Weight = _expf(-(float)(j*j) * InvTwoSigmaSq) * BlurMapWeight;

            SumColor.x += SampleColor.x * Weight;
