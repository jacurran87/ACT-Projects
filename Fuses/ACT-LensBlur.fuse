local FuseName = "Lens Blur"
local FuseVersion = "1.3"
local FuseAuthor = "Abi Yasid Al'Majid"
local FuseDescription = "A blur filter that simulates realistic depth of field and bokeh effects. This tool offers customization of the bokeh shape and features built-in chromatic aberration to mimic real-world lens imperfections with support for both blur maps or depth maps to enables precise variable blur distribution."

FuRegisterClass("LensBlur", CT_Tool, {
    REGS_Name = FuseName,
    REGS_Category = "ACTProjects\\Blur",
    REGS_OpIconString = "ACT-LnBl",
    REGS_OpDescription = "A blur filter that simulates realistic depth of field and bokeh effects",
    REG_NoObjMatCtrls = true,
    REG_NoMotionBlurCtrls = true,
    REG_Fuse_NoEdit = true,
    REG_Fuse_NoReload = true,
    REG_Version = 1.3,
})

ACTLnBL_Params = [[
    int SrcSize[2];

    int ViewMode;
    float BlurSize;
    float HlThreshold;
    float HlLevel;

    float CACenter[2];
    float CADistance;
    int CABlend;
    int CAUseMap;

    int LensType;
    int LensSides;
    float LensShape;
    float LensAngle;
    float Anamorphism;

    int Method;
    int InvertMap;

    float FocusPosition;
    float FocalRegion;
    float FocusTransition;

    int SrcOrigin[2];
    int SrcFullSize[2];
    int MapSize[2];
    int MapOrigin[2];
    int MapFullSize[2];
    int FocusSource;
    float FocusPoint[2];
    float ManualFocus;
    int SampleArea;
    int NearWhite;
    float SharpRange;
    float Falloff;
    float DepthResponse;
    float ForegroundAmount;
    float BackgroundAmount;
    int Samples;
    float AspectX;
    float AspectY;
    float ApertureArea;
    float TapX[256];
    float TapY[256];
    float TapWeight[256];
]]

ACTLnBl_Source = [[
    __KERNEL__ void ACTLnBl_ProcessKernel(
        __CONSTANTREF__ ACTLnBL_Params *Params,
        __TEXTURE2D__ SourceImage,
        __TEXTURE2D_WRITE__ Destination)
    {
        DEFINE_KERNEL_ITERATORS_XY(x, y)
        if (x >= Params->SrcSize[0] || y >= Params->SrcSize[1]) return;

        if (Params->ViewMode == 2) {
            _tex2DVec4Write(Destination, x, y, to_float4(1.0f, 1.0f, 1.0f, 1.0f));
            return;
        }

        if (Params->ViewMode == 1) {
            float4 SrcColor = _tex2DVec4(SourceImage, x + 0.5f, y + 0.5f);
            float Luma = (SrcColor.x * 0.299f + SrcColor.y * 0.587f + SrcColor.z * 0.114f);

            float MaskValue = 0.0f;
            if (Luma > Params->HlThreshold) {
                MaskValue = (Luma - Params->HlThreshold) * Params->HlLevel * 50.0f;
            }

            _tex2DVec4Write(Destination, x, y, to_float4(MaskValue, MaskValue, MaskValue, 1.0f));
            return;
        }

        float Radius = Params->BlurSize;

        if (Radius < 0.5f) {
            _tex2DVec4Write(Destination, x, y, _tex2DVec4(SourceImage, x + 0.5f, y + 0.5f));
            return;
        }

        float4 SumColor = to_float4_s(0.0f);
        float SumWeight = 0.0f;

        float Aspect = 1.0f + (2.0f * _fabs(Params->Anamorphism));
        float AspectX = (Params->Anamorphism > 0.0f) ? Aspect : 1.0f;
        float AspectY = (Params->Anamorphism < 0.0f) ? Aspect : 1.0f;

        int RadiusX = (int)_ceilf(Radius / AspectX);
        int RadiusY = (int)_ceilf(Radius / AspectY);

        float AngleRad = Params->LensAngle * 3.14159265359f / 180.0f;
        float Segment = 2.0f * 3.14159265359f / (float)Params->LensSides;
        float CosPiOverN = _cosf(3.14159265359f / (float)Params->LensSides);

        for (int dy = -RadiusY; dy <= RadiusY; dy++) {
            for (int dx = -RadiusX; dx <= RadiusX; dx++) {

                float ScaledDx = (float)dx * AspectX;
                float ScaledDy = (float)dy * AspectY;
                float NeighborDist = _sqrtf(ScaledDx * ScaledDx + ScaledDy * ScaledDy);

                float NeighborRadius = Params->BlurSize;
                float NeighborFinalDist = 0.0f;

                if (dx != 0 || dy != 0) {
                    if (Params->LensType == 0) {
                        NeighborFinalDist = NeighborDist;
                    } else {
                        float NeighborAngle = _atan2f(-ScaledDy, -ScaledDx) + AngleRad;
                        NeighborAngle = NeighborAngle - Segment * _floorf(NeighborAngle / Segment) - Segment / 2.0f;

                        float NeighborDistPoly = NeighborDist * _cosf(NeighborAngle) / CosPiOverN;
                        NeighborFinalDist = (NeighborDistPoly * (1.0f - Params->LensShape)) + (NeighborDist * Params->LensShape);
                    }
                }

                float Coverage = 1.0f;
                if (dx != 0 || dy != 0) {
                    Coverage = _clampf(NeighborRadius - NeighborFinalDist + 0.5f, 0.0f, 1.0f);
                }

                if (Coverage > 0.0f) {
                    float4 NeighborColor = _tex2DVec4(SourceImage, x + dx + 0.5f, y + dy + 0.5f);
                    float Luma = (NeighborColor.x * 0.299f + NeighborColor.y * 0.587f + NeighborColor.z * 0.114f);

                    float Boost = 1.0f;
                    if (Luma > Params->HlThreshold) {
                        Boost += (Luma - Params->HlThreshold) * Params->HlLevel * 50.0f;
                    }

                    float FinalWeight = Boost * Coverage;

                    SumColor += NeighborColor * FinalWeight;
                    SumWeight += FinalWeight;
                }
            }
        }

        if (SumWeight > 0.0f) {
            _tex2DVec4Write(Destination, x, y, (SumColor / SumWeight));
        } else {
            _tex2DVec4Write(Destination, x, y, _tex2DVec4(SourceImage, x + 0.5f, y + 0.5f));
        }
    }

    __KERNEL__ void ACTLnBl_CAKernel(
        __CONSTANTREF__ ACTLnBL_Params *Params,
        __TEXTURE2D__ SourceImage,
        __TEXTURE2D_WRITE__ Destination)
    {
        DEFINE_KERNEL_ITERATORS_XY(x, y)
        if (x >= Params->SrcSize[0] || y >= Params->SrcSize[1]) return;

        if (Params->ViewMode != 0 || _fabs(Params->CADistance) <= 0.0001f || Params->CABlend < 2) {
            _tex2DVec4Write(Destination, x, y, _tex2DVec4(SourceImage, x + 0.5f, y + 0.5f));
            return;
        }

        float2 CenterPos = to_float2(Params->CACenter[0] * Params->SrcSize[0], Params->CACenter[1] * Params->SrcSize[1]);
        float2 UvPos = to_float2(x + 0.5f, y + 0.5f);
        float2 Dir = UvPos - CenterPos;

        int Steps = Params->CABlend;
        float StepInv = 1.0f / (float)(Steps - 1);
        float CAScale = Params->CADistance * 0.1f;

        float4 OutColor = to_float4_s(0.0f);
        float SumR = 0.0f;
        float SumG = 0.0f;
        float SumB = 0.0f;
        float SumA = 0.0f;

        for (int i = 0; i < Steps; i++) {
            float T = (float)i * StepInv;

            float Scale = 1.0f + CAScale * (T * 2.0f - 1.0f);
            float2 SamplePos = CenterPos + Dir * Scale;
            float4 SampColor = _tex2DVec4(SourceImage, SamplePos.x, SamplePos.y);

            float T2 = T * 2.0f;
            float WeightR = _clampf(1.0f - _fabs(T2), 0.0f, 1.0f);
            float WeightG = _clampf(1.0f - _fabs(T2 - 1.0f), 0.0f, 1.0f);
            float WeightB = _clampf(1.0f - _fabs(T2 - 2.0f), 0.0f, 1.0f);

            OutColor.x += SampColor.x * WeightR;
            SumR += WeightR;

            OutColor.y += SampColor.y * WeightG;
            SumG += WeightG;

            OutColor.z += SampColor.z * WeightB;
            SumB += WeightB;

            OutColor.w += SampColor.w;
            SumA += 1.0f;
        }

        OutColor.x /= (SumR > 0.0f) ? SumR : 1.0f;
        OutColor.y /= (SumG > 0.0f) ? SumG : 1.0f;
        OutColor.z /= (SumB > 0.0f) ? SumB : 1.0f;
        OutColor.w /= (SumA > 0.0f) ? SumA : 1.0f;

        _tex2DVec4Write(Destination, x, y, OutColor);
    }
]]

ACTLnBl_SourceBM = [[
    __KERNEL__ void ACTLnBl_ProcessKernelBM(
        __CONSTANTREF__ ACTLnBL_Params *Params,
        __TEXTURE2D__ SourceImage,
        __TEXTURE2D__ BlurMapImage,
        __TEXTURE2D_WRITE__ Destination)
    {
        DEFINE_KERNEL_ITERATORS_XY(x, y)
        if (x >= Params->SrcSize[0] || y >= Params->SrcSize[1]) return;

        float BlurValue = 1.0f;

        if (Params->Method > 0) {
            float4 DepthColor = _tex2DVec4(BlurMapImage, x + 0.5f, y + 0.5f);
            BlurValue = _fmaxf(DepthColor.x, _fmaxf(DepthColor.y, DepthColor.z));

            if (Params->InvertMap == 1) {
                BlurValue = 1.0f - BlurValue;
            }

            if (Params->Method == 2) {
                float Dist = _fabs(BlurValue - Params->FocusPosition);
                Dist = _fmaxf(Dist - Params->FocalRegion, 0.0f);

                float Transition = _fmaxf(Params->FocusTransition, 0.0001f);
                BlurValue = _clampf(Dist / Transition, 0.0f, 1.0f);
            }
        }

        if (Params->ViewMode == 2) {
            _tex2DVec4Write(Destination, x, y, to_float4(BlurValue, BlurValue, BlurValue, 1.0f));
            return;
        }

        if (Params->ViewMode == 1) {
            float4 SrcColor = _tex2DVec4(SourceImage, x + 0.5f, y + 0.5f);
            float Luma = (SrcColor.x * 0.299f + SrcColor.y * 0.587f + SrcColor.z * 0.114f);

            float MaskValue = 0.0f;
            if (Luma > Params->HlThreshold) {
                MaskValue = (Luma - Params->HlThreshold) * Params->HlLevel * 50.0f;
            }

            _tex2DVec4Write(Destination, x, y, to_float4(MaskValue, MaskValue, MaskValue, 1.0f));
            return;
        }

        float Radius = Params->BlurSize * BlurValue;

        if (Radius < 0.5f) {
            _tex2DVec4Write(Destination, x, y, _tex2DVec4(SourceImage, x + 0.5f, y + 0.5f));
            return;
        }

        float4 SumColor = to_float4_s(0.0f);
        float SumWeight = 0.0f;

        float Aspect = 1.0f + (2.0f * _fabs(Params->Anamorphism));
        float AspectX = (Params->Anamorphism > 0.0f) ? Aspect : 1.0f;
        float AspectY = (Params->Anamorphism < 0.0f) ? Aspect : 1.0f;

        int RadiusX = (int)_ceilf(Radius / AspectX);
        int RadiusY = (int)_ceilf(Radius / AspectY);

        float AngleRad = Params->LensAngle * 3.14159265359f / 180.0f;
        float Segment = 2.0f * 3.14159265359f / (float)Params->LensSides;
        float CosPiOverN = _cosf(3.14159265359f / (float)Params->LensSides);

        for (int dy = -RadiusY; dy <= RadiusY; dy++) {
            for (int dx = -RadiusX; dx <= RadiusX; dx++) {

                float ScaledDx = (float)dx * AspectX;
                float ScaledDy = (float)dy * AspectY;
                float NeighborDist = _sqrtf(ScaledDx * ScaledDx + ScaledDy * ScaledDy);

                float NeighborRadius = Params->BlurSize;

                if (Params->Method > 0) {
                    float4 NeighborMap = _tex2DVec4(BlurMapImage, x + dx + 0.5f, y + dy + 0.5f);
                    float NeighborValue = _fmaxf(NeighborMap.x, _fmaxf(NeighborMap.y, NeighborMap.z));

                    if (Params->InvertMap == 1) {
                        NeighborValue = 1.0f - NeighborValue;
                    }

                    if (Params->Method == 2) {
                        float Dist = _fabs(NeighborValue - Params->FocusPosition);
                        Dist = _fmaxf(Dist - Params->FocalRegion, 0.0f);

                        float Transition = _fmaxf(Params->FocusTransition, 0.0001f);
                        NeighborValue = _clampf(Dist / Transition, 0.0f, 1.0f);
                    }

                    NeighborRadius *= NeighborValue;
                }

                float NeighborFinalDist = 0.0f;

                if (dx != 0 || dy != 0) {
                    if (Params->LensType == 0) {
                        NeighborFinalDist = NeighborDist;
                    } else {
                        float NeighborAngle = _atan2f(-ScaledDy, -ScaledDx) + AngleRad;
                        NeighborAngle = NeighborAngle - Segment * _floorf(NeighborAngle / Segment) - Segment / 2.0f;

                        float NeighborDistPoly = NeighborDist * _cosf(NeighborAngle) / CosPiOverN;
                        NeighborFinalDist = (NeighborDistPoly * (1.0f - Params->LensShape)) + (NeighborDist * Params->LensShape);
                    }
                }

                float Coverage = 1.0f;
                if (dx != 0 || dy != 0) {
                    Coverage = _clampf(NeighborRadius - NeighborFinalDist + 0.5f, 0.0f, 1.0f);
                }

                if (Coverage > 0.0f) {
                    float4 NeighborColor = _tex2DVec4(SourceImage, x + dx + 0.5f, y + dy + 0.5f);
                    float Luma = (NeighborColor.x * 0.299f + NeighborColor.y * 0.587f + NeighborColor.z * 0.114f);

                    float Boost = 1.0f;
                    if (Luma > Params->HlThreshold) {
                        Boost += (Luma - Params->HlThreshold) * Params->HlLevel * 50.0f;
                    }

                    float FinalWeight = Boost * Coverage;

                    SumColor += NeighborColor * FinalWeight;
                    SumWeight += FinalWeight;
                }
            }
        }

        if (SumWeight > 0.0f) {
            _tex2DVec4Write(Destination, x, y, (SumColor / SumWeight));
        } else {
            _tex2DVec4Write(Destination, x, y, _tex2DVec4(SourceImage, x + 0.5f, y + 0.5f));
        }
    }

    __KERNEL__ void ACTLnBl_CAKernelBM(
        __CONSTANTREF__ ACTLnBL_Params *Params,
        __TEXTURE2D__ SourceImage,
        __TEXTURE2D__ BlurMapImage,
        __TEXTURE2D_WRITE__ Destination)
    {
        DEFINE_KERNEL_ITERATORS_XY(x, y)
        if (x >= Params->SrcSize[0] || y >= Params->SrcSize[1]) return;

        if (Params->ViewMode != 0 || _fabs(Params->CADistance) <= 0.0001f || Params->CABlend < 2) {
            _tex2DVec4Write(Destination, x, y, _tex2DVec4(SourceImage, x + 0.5f, y + 0.5f));
            return;
        }

        float MapValue = 1.0f;

        if (Params->CAUseMap == 1) {
            float4 DepthColor = _tex2DVec4(BlurMapImage, x + 0.5f, y + 0.5f);
            MapValue = _fmaxf(DepthColor.x, _fmaxf(DepthColor.y, DepthColor.z));

            if (Params->InvertMap == 1) {
                MapValue = 1.0f - MapValue;
            }

            if (Params->Method == 2) {
                float Dist = _fabs(MapValue - Params->FocusPosition);
                Dist = _fmaxf(Dist - Params->FocalRegion, 0.0f);

                float Transition = _fmaxf(Params->FocusTransition, 0.0001f);
                MapValue = _clampf(Dist / Transition, 0.0f, 1.0f);
            }
        }

        float2 CenterPos = to_float2(Params->CACenter[0] * Params->SrcSize[0], Params->CACenter[1] * Params->SrcSize[1]);
        float2 UvPos = to_float2(x + 0.5f, y + 0.5f);
        float2 Dir = UvPos - CenterPos;

        int Steps = Params->CABlend;
        float StepInv = 1.0f / (float)(Steps - 1);
        float CAScale = Params->CADistance * 0.1f * MapValue;

        float4 OutColor = to_float4_s(0.0f);
        float SumR = 0.0f;
        float SumG = 0.0f;
        float SumB = 0.0f;
        float SumA = 0.0f;

        for (int i = 0; i < Steps; i++) {
            float T = (float)i * StepInv;

            float Scale = 1.0f + CAScale * (T * 2.0f - 1.0f);
            float2 SamplePos = CenterPos + Dir * Scale;
            float4 SampColor = _tex2DVec4(SourceImage, SamplePos.x, SamplePos.y);

            float T2 = T * 2.0f;
            float WeightR = _clampf(1.0f - _fabs(T2), 0.0f, 1.0f);
            float WeightG = _clampf(1.0f - _fabs(T2 - 1.0f), 0.0f, 1.0f);
            float WeightB = _clampf(1.0f - _fabs(T2 - 2.0f), 0.0f, 1.0f);

            OutColor.x += SampColor.x * WeightR;
            SumR += WeightR;

            OutColor.y += SampColor.y * WeightG;
            SumG += WeightG;

            OutColor.z += SampColor.z * WeightB;
            SumB += WeightB;

            OutColor.w += SampColor.w;
            SumA += 1.0f;
        }

        OutColor.x /= (SumR > 0.0f) ? SumR : 1.0f;
        OutColor.y /= (SumG > 0.0f) ? SumG : 1.0f;
        OutColor.z /= (SumB > 0.0f) ? SumB : 1.0f;
        OutColor.w /= (SumA > 0.0f) ? SumA : 1.0f;

        _tex2DVec4Write(Destination, x, y, OutColor);
    }
]]

ACTLnBl_RelativeSource = [[
    // All coordinates are in pixels. Clamp samplers work on Metal, CUDA and OpenCL.
    __DEVICE__ float ACTLnBl_Depth(float4 color) {
        return _clampf(_fmaxf(color.x, _fmaxf(color.y, color.z)), 0.0f, 1.0f);
    }

    __DEVICE__ float ACTLnBl_OrientedDepth(float value, int nearWhite) {
        return nearWhite == 1 ? value : 1.0f - value;
    }

    __DEVICE__ float ACTLnBl_ShapeDistance(float dx, float dy,
        __CONSTANTREF__ ACTLnBL_Params *Params) {
        float sx = dx * Params->AspectX;
        float sy = dy * Params->AspectY;
        float dist = _sqrtf(sx * sx + sy * sy);
        if (Params->LensType == 0 || dist < 0.0001f) return dist;
        float segment = 6.28318530718f / (float)Params->LensSides;
        float angle = _atan2f(-sy, -sx) + Params->LensAngle * 0.01745329252f;
        angle = angle - segment * _floorf(angle / segment) - segment * 0.5f;
        float polygon = dist * _cosf(angle) / _cosf(3.14159265359f / (float)Params->LensSides);
        return polygon * (1.0f - Params->LensShape) + dist * Params->LensShape;
    }

    __KERNEL__ void ACTLnBl_FocusKernel(
        __CONSTANTREF__ ACTLnBL_Params *Params,
        __TEXTURE2D__ BlurMapImage,
        __TEXTURE2D_WRITE__ Destination)
    {
        DEFINE_KERNEL_ITERATORS_XY(x, y)
        if (x != 0 || y != 0) return;
        float focus = Params->ManualFocus;
        if (Params->FocusSource == 1) {
            // Point controls use full-frame normalized coordinates, like Tracker positions.
            float px = Params->FocusPoint[0] * Params->MapFullSize[0] - Params->MapOrigin[0];
            float py = Params->FocusPoint[1] * Params->MapFullSize[1] - Params->MapOrigin[1];
            float total = 0.0f;
            float count = 0.0f;
            int area = Params->SampleArea;
            for (int dy = -area; dy <= area; dy++) {
                for (int dx = -area; dx <= area; dx++) {
                    float sx = _clampf(px + dx, 0.5f, Params->MapSize[0] - 0.5f);
                    float sy = _clampf(py + dy, 0.5f, Params->MapSize[1] - 0.5f);
                    total += ACTLnBl_Depth(_tex2DVec4(BlurMapImage, sx, sy));
                    count += 1.0f;
                }
            }
            focus = total / count;
        }
        focus = ACTLnBl_OrientedDepth(focus, Params->NearWhite);
        _tex2DVec4Write(Destination, x, y, to_float4(focus, focus, focus, 1.0f));
    }

    __KERNEL__ void ACTLnBl_PrepareKernel(
        __CONSTANTREF__ ACTLnBL_Params *Params,
        __TEXTURE2D__ BlurMapImage,
        __TEXTURE2D__ FocusImage,
        __TEXTURE2D_WRITE__ Destination)
    {
        DEFINE_KERNEL_ITERATORS_XY(x, y)
        if (x >= Params->SrcSize[0] || y >= Params->SrcSize[1]) return;
        float mx = (Params->SrcOrigin[0] + x + 0.5f) * Params->MapFullSize[0] / Params->SrcFullSize[0] - Params->MapOrigin[0];
        float my = (Params->SrcOrigin[1] + y + 0.5f) * Params->MapFullSize[1] / Params->SrcFullSize[1] - Params->MapOrigin[1];
        float raw = ACTLnBl_Depth(_tex2DVec4(BlurMapImage, mx, my));
        float depth = raw;
        float blur = 1.0f;
        float side = 0.0f;
        if (Params->Method == 3) {
            depth = ACTLnBl_OrientedDepth(raw, Params->NearWhite);
            float focus = Params->FocusSource == 1 ? _tex2DVec4(FocusImage, 0.5f, 0.5f).x : ACTLnBl_OrientedDepth(Params->ManualFocus, Params->NearWhite);
            float delta = depth - focus;
            float amount = delta > 0.0f ? Params->ForegroundAmount : Params->BackgroundAmount;
            float distance = _fmaxf(_fabs(delta) - Params->SharpRange * 0.5f, 0.0f);
            blur = _powf(_clampf(distance / _fmaxf(Params->Falloff, 0.0001f), 0.0f, 1.0f), Params->DepthResponse);
            blur = _clampf(blur * amount, 0.0f, 1.0f);
            side = delta > 0.0f ? 1.0f : -1.0f;
            if (distance == 0.0f) side = 0.0f;
        } else if (Params->Method > 0) {
            blur = Params->InvertMap == 1 ? 1.0f - raw : raw;
            if (Params->Method == 2) {
                float distance = _fmaxf(_fabs(blur - Params->FocusPosition) - Params->FocalRegion, 0.0f);
                blur = _clampf(distance / _fmaxf(Params->FocusTransition, 0.0001f), 0.0f, 1.0f);
            }
        }
        // R: blur amount; G: oriented depth (larger = nearer); B: focus side.
        _tex2DVec4Write(Destination, x, y, to_float4(blur, depth, side, 1.0f));
    }

    __KERNEL__ void ACTLnBl_FastKernel(
        __CONSTANTREF__ ACTLnBL_Params *Params,
        __TEXTURE2D__ SourceImage,
        __TEXTURE2D__ PreparedMap,
        __TEXTURE2D_WRITE__ Destination)
    {
        DEFINE_KERNEL_ITERATORS_XY(x, y)
        if (x >= Params->SrcSize[0] || y >= Params->SrcSize[1]) return;
        float px = x + 0.5f;
        float py = y + 0.5f;
        float4 source = _tex2DVec4(SourceImage, px, py);
        float4 info = _tex2DVec4(PreparedMap, px, py);
        if (Params->ViewMode == 1) {
            float luma = source.x * 0.299f + source.y * 0.587f + source.z * 0.114f;
            float mask = _fmaxf(luma - Params->HlThreshold, 0.0f) * Params->HlLevel * 50.0f;
            _tex2DVec4Write(Destination, x, y, to_float4(mask, mask, mask, 1.0f));
            return;
        }
        if (Params->ViewMode == 2) {
            _tex2DVec4Write(Destination, x, y, to_float4(info.x, info.x, info.x, 1.0f));
            return;
        }
        if (Params->ViewMode == 3) {
            // Green = sharp; orange = foreground; blue = background.
            float3 sharp = to_float3(0.12f, 0.85f, 0.25f);
            float3 defocus = info.z > 0.0f ? to_float3(1.0f, 0.3f, 0.06f) : to_float3(0.12f, 0.35f, 1.0f);
            float3 color = sharp * (1.0f - info.x) + defocus * info.x;
            _tex2DVec4Write(Destination, x, y, to_float4(color.x, color.y, color.z, 1.0f));
            return;
        }
        float radius = Params->BlurSize;
        if (radius < 0.5f) {
            _tex2DVec4Write(Destination, x, y, source);
            return;
        }
        float localRadius = radius * info.x;
        float tolerance = _fmaxf(Params->SharpRange * 0.5f, 0.02f);
        float4 sum = to_float4_s(0.0f);
        float sumWeight = 0.0f;
        float4 nearSum = to_float4_s(0.0f);
        float nearWeight = 0.0f;
        float nearCoverage = 0.0f;
        int rx = (int)_ceilf(radius / Params->AspectX);
        int ry = (int)_ceilf(radius / Params->AspectY);
        int gridWidth = 2 * rx + 1;
        int count = Params->Samples > 0 ? Params->Samples : gridWidth * (2 * ry + 1);
        for (int i = 0; i < count; i++) {
            float ox;
            float oy;
            float shapeDist;
            float areaWeight;
            if (Params->Samples > 0) {
                ox = Params->TapX[i] * radius;
                oy = Params->TapY[i] * radius;
                shapeDist = _sqrtf(((float)i + 0.5f) / (float)Params->Samples) * radius;
                areaWeight = Params->TapWeight[i];
            } else {
                ox = (float)(i % gridWidth - rx);
                oy = (float)(i / gridWidth - ry);
                shapeDist = ACTLnBl_ShapeDistance(ox, oy, Params);
                if (shapeDist > radius) continue;
                areaWeight = 1.0f;
            }
            if (localRadius >= 0.5f) {
                float sx = px + ox * info.x;
                float sy = py + oy * info.x;
                float4 sampleInfo = _tex2DVec4(PreparedMap, sx, sy);
                // Keep foreground and background surfaces separate at silhouettes.
                float edgeWeight = (Params->Method != 3 || _fabs(sampleInfo.y - info.y) <= tolerance) ? 1.0f : 0.0f;
                if (edgeWeight > 0.0f) {
                    float4 color = _tex2DVec4(SourceImage, sx, sy);
                    float luma = color.x * 0.299f + color.y * 0.587f + color.z * 0.114f;
                    float boost = 1.0f + _fmaxf(luma - Params->HlThreshold, 0.0f) * Params->HlLevel * 50.0f;
                    float weight = areaWeight * boost;
                    sum += color * weight;
                    sumWeight += weight;
                }
            }
            if (Params->Method == 3 && Params->ForegroundAmount > 0.0f) {
                float4 neighbor = _tex2DVec4(PreparedMap, px + ox, py + oy);
                float nr = neighbor.x * radius;
                if (neighbor.z > 0.0f && neighbor.y > info.y + 0.0001f && nr >= 0.5f) {
                    float coverage = _clampf(nr - shapeDist + 0.5f, 0.0f, 1.0f);
                    if (coverage > 0.0f) {
                        float4 color = _tex2DVec4(SourceImage, px + ox, py + oy);
                        float weight = coverage * areaWeight / _fmaxf(nr * nr, 0.25f);
                        float luma = color.x * 0.299f + color.y * 0.587f + color.z * 0.114f;
                        float boost = 1.0f + _fmaxf(luma - Params->HlThreshold, 0.0f) * Params->HlLevel * 50.0f;
                        nearCoverage += weight;
                        nearSum += color * weight * boost;
                        nearWeight += weight * boost;
                    }
                }
            }
        }
        float4 result = sumWeight > 0.0f ? sum / sumWeight : source;
        if (nearWeight > 0.0f) {
            float4 front = nearSum / nearWeight;
            // Integrate foreground footprint coverage, then composite premultiplied color.
            float coverageScale = Params->Samples > 0 ? radius * radius / (float)Params->Samples : 1.0f / Params->ApertureArea;
            float coverage = _clampf(nearCoverage * coverageScale, 0.0f, 1.0f);
            result = front * coverage + result * (1.0f - front.w * coverage);
        }
        _tex2DVec4Write(Destination, x, y, result);
    }
    __KERNEL__ void ACTLnBl_CAFastKernel(
        __CONSTANTREF__ ACTLnBL_Params *Params,
        __TEXTURE2D__ SourceImage,
        __TEXTURE2D__ PreparedMap,
        __TEXTURE2D_WRITE__ Destination)
    {
        DEFINE_KERNEL_ITERATORS_XY(x, y)
        if (x >= Params->SrcSize[0] || y >= Params->SrcSize[1]) return;

        if (Params->ViewMode != 0 || _fabs(Params->CADistance) <= 0.0001f || Params->CABlend < 2) {
            _tex2DVec4Write(Destination, x, y, _tex2DVec4(SourceImage, x + 0.5f, y + 0.5f));
            return;
        }

        float MapValue = Params->CAUseMap == 1 ? _tex2DVec4(PreparedMap, x + 0.5f, y + 0.5f).x : 1.0f;

        float2 CenterPos = to_float2(Params->CACenter[0] * Params->SrcSize[0], Params->CACenter[1] * Params->SrcSize[1]);
        float2 UvPos = to_float2(x + 0.5f, y + 0.5f);
        float2 Dir = UvPos - CenterPos;

        int Steps = Params->CABlend;
        float StepInv = 1.0f / (float)(Steps - 1);
        float CAScale = Params->CADistance * 0.1f * MapValue;

        float4 OutColor = to_float4_s(0.0f);
        float SumR = 0.0f;
        float SumG = 0.0f;
        float SumB = 0.0f;
        float SumA = 0.0f;

        for (int i = 0; i < Steps; i++) {
            float T = (float)i * StepInv;

            float Scale = 1.0f + CAScale * (T * 2.0f - 1.0f);
            float2 SamplePos = CenterPos + Dir * Scale;
            float4 SampColor = _tex2DVec4(SourceImage, SamplePos.x, SamplePos.y);

            float T2 = T * 2.0f;
            float WeightR = _clampf(1.0f - _fabs(T2), 0.0f, 1.0f);
            float WeightG = _clampf(1.0f - _fabs(T2 - 1.0f), 0.0f, 1.0f);
            float WeightB = _clampf(1.0f - _fabs(T2 - 2.0f), 0.0f, 1.0f);

            OutColor.x += SampColor.x * WeightR;
            SumR += WeightR;

            OutColor.y += SampColor.y * WeightG;
            SumG += WeightG;

            OutColor.z += SampColor.z * WeightB;
            SumB += WeightB;

            OutColor.w += SampColor.w;
            SumA += 1.0f;
        }

        OutColor.x /= (SumR > 0.0f) ? SumR : 1.0f;
        OutColor.y /= (SumG > 0.0f) ? SumG : 1.0f;
        OutColor.z /= (SumB > 0.0f) ? SumB : 1.0f;
        OutColor.w /= (SumA > 0.0f) ? SumA : 1.0f;

        _tex2DVec4Write(Destination, x, y, OutColor);
    }
]]

ACTLogo = [[
    <center><img width="300" src='data:image/png;base64, '></center>
]]

local VersionUI = string.format([[
    <center><b>%s v%s</b></center>
]], FuseName, FuseVersion)

local DescriptionUI = string.format([[
    <h3 style="line-height: 0.5;" >ACT %s</h3>
    <p>Version %s | By %s</p>
    <p>%s</p>
    <br>
]], FuseName, FuseVersion, FuseAuthor, FuseDescription)

local function SetControlVisible(input, visible)
    if input then input:SetAttrs({ IC_Visible = visible }) end
end

local function UpdateFocusControls(changed, parameter)
    local function current(input)
        if input == changed and parameter then return parameter end
        return input and input:GetSource(self.Comp and self.Comp.CurrentTime) or nil
    end
    local method = current(InMethod)
    local source = current(InFocusSource)
    local lens = current(InLensType)
    local mode = method and method.Value or 0
    local point = source and source.Value == 1
    SetControlVisible(InLensSides, lens and lens.Value == 1)
    SetControlVisible(InLensShape, lens and lens.Value == 1)
    SetControlVisible(InLensAngle, lens and lens.Value == 1)
    SetControlVisible(InInvertMap, mode == 1 or mode == 2)
    SetControlVisible(InFocusPos, mode == 2)
    SetControlVisible(InFocalRegion, mode == 2)
    SetControlVisible(InFocusTransition, mode == 2)
    for _, input in ipairs({ InFocusSource, InNearWhite, InSharpRange, InFalloff,
        InDepthResponse, InForegroundAmount, InBackgroundAmount }) do
        SetControlVisible(input, mode == 3)
    end
    SetControlVisible(InManualFocus, mode == 3 and not point)
    SetControlVisible(InFocusPoint, mode == 3 and point)
    SetControlVisible(InSampleArea, mode == 3 and point)
    if InFocusPoint then InFocusPoint:SetAttrs({ PC_Visible = mode == 3 and point }) end
end

function NotifyChanged(inp, param)
    -- Honor the changed value even when the host has not committed it yet.
    if inp == InLensType or inp == InMethod or inp == InFocusSource then
        UpdateFocusControls(inp, param)
    end
end

function OnConnected(inp, old, new)
    if inp == InBlurMap then
        -- Keep Method visible so the new workflow can be set up before connecting a map.
        SetControlVisible(InCAUseMap, new ~= nil)
        UpdateFocusControls()
    end
end

function Create()
    InImage = self:AddInput("Image", "Input", {
        INP_AcceptsDoD = false,
        LINKID_DataType = "Image",
        LINK_Main       = 1,
    })

    InBlurMap = self:AddInput("Blur Map", "BlurMap", {
        INP_AcceptsDoD = false,
        LINKID_DataType = "Image",
        LINK_Main       = 2,
        INP_Required    = false,
    })

    InLogo = self:AddInput(ACTLogo, "Logo", {
        LINKID_DataType    = "Text",
        INPID_InputControl = "LabelControl",
        INP_External       = false,
        INP_Passive        = true,
        IC_ControlPage     = -1,
        IC_NoLabel         = true,
        IC_NoReset         = true,
        LBLC_MultiLine     = true,
    })

    InVersion = self:AddInput(VersionUI, "Version", {
        LINKID_DataType    = "Text",
        INPID_InputControl = "LabelControl",
        INP_External       = false,
        INP_Passive        = true,
        IC_ControlPage     = -1,
        IC_NoLabel         = true,
        IC_NoReset         = true,
        LBLC_MultiLine     = true,
    })

    InViewMode = self:AddInput("View Mode", "ViewMode", {
        LINKID_DataType    = "Number",
        INPID_InputControl = "ComboControl",
        INP_Integer        = true,
        INP_Default        = 0.0,
        { CCS_AddString = "Final" },
        { CCS_AddString = "Highlight Mask" },
        { CCS_AddString = "Focus Mask" },
        { CCS_AddString = "Focus Zones" },
    })

    self:BeginControlNest("Blur Settings", "BlurSettingsNest", true, {})

    InBlurSize = self:AddInput("Blur Size", "BlurSize", {
        LINKID_DataType    = "Number",
        INPID_InputControl = "SliderControl",
        INP_Integer        = true,
        INP_Default        = 10.0,
        INP_MinAllowed     = 0.0,
        INP_MaxScale       = 50.0,
    })

    InQuality = self:AddInput("Render Quality", "RenderQuality", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Integer = true,
        INP_Default = 0,
        { CCS_AddString = "Reference (Original)" },
        { CCS_AddString = "Draft (32 samples)" },
        { CCS_AddString = "Standard (96 samples)" },
        { CCS_AddString = "High (256 samples)" },
    })

    InHLThreshold = self:AddInput("Highlight Threshold", "HLThreshold", {
        LINKID_DataType    = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default        = 0.75,
        INP_MinAllowed     = 0.0,
        INP_MaxAllowed     = 1.0,
    })

    InHLLevel = self:AddInput("Highlight Level", "HLLevel", {
        LINKID_DataType    = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default        = 1.0,
        INP_MinAllowed     = 0.0,
        INP_MaxScale       = 2.0,
    })

    self:EndControlNest()

    self:BeginControlNest("Chromatic Aberration", "ChromaticAberrationNest", true, {})

    InCACenter = self:AddInput("Aberration Center", "CACenter", {
        LINKID_DataType      = "Point",
        INPID_InputControl   = "OffsetControl",
        INPID_PreviewControl = "CrosshairControl",
        INP_DefaultX         = 0.5,
        INP_DefaultY         = 0.5,
    })

    InCADistance = self:AddInput("Aberration Distance", "CADistance", {
        LINKID_DataType    = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default        = 0.0,
        INP_MinAllowed     = -10.0,
        INP_MaxAllowed     = 10.0,
        INP_MinScale       = -1.0,
        INP_MaxScale       = 1.0,
    })

    InCABlend = self:AddInput("Blend Aberration", "CABlend", {
        LINKID_DataType    = "Number",
        INPID_InputControl = "SliderControl",
        INP_Integer        = true,
        INP_Default        = 15,
        INP_MinAllowed     = 3,
        INP_MaxAllowed     = 1000,
        INP_MaxScale       = 100,
    })

    InCAUseMap = self:AddInput("Use Blur Map", "CAUseMap", {
