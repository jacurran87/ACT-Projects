        INP_MaxScale       = 2.0,
        IC_Visible         = false,
    })


    InFocusSource = self:AddInput("Focus Source", "FocusSource", {
        LINKID_DataType = "Number", INPID_InputControl = "ComboControl",
        INP_Integer = true, INP_Default = 0, INP_DoNotifyChanged = true, IC_Visible = false,
