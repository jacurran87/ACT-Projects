    })
    InManualFocus = self:AddInput("Focus Depth", "FocusDepth", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 0.5, INP_MinAllowed = 0, INP_MaxAllowed = 1, IC_Visible = false,
    })
    InFocusPoint = self:AddInput("Focus Point", "FocusPoint", {
        LINKID_DataType = "Point", INPID_InputControl = "OffsetControl",
        INPID_PreviewControl = "CrosshairControl", INP_DefaultX = 0.5, INP_DefaultY = 0.5,
        IC_Visible = false, PC_Visible = false,
    })
    InSampleArea = self:AddInput("Sample Area (radius in map pixels)", "SampleArea", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Integer = true,
        INP_Default = 1, INP_MinAllowed = 0, INP_MaxAllowed = 8, IC_Visible = false,
    })
    InNearWhite = self:AddInput("Depth Direction", "NearWhite", {
        LINKID_DataType = "Number", INPID_InputControl = "ComboControl",
        INP_Integer = true, INP_Default = 1, IC_Visible = false,
        { CCS_AddString = "Near Is Black" }, { CCS_AddString = "Near Is White" },
    })
    InSharpRange = self:AddInput("Sharp Range (full width)", "SharpRange", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 0.02, INP_MinAllowed = 0, INP_MaxAllowed = 1, IC_Visible = false,
    })
    InFalloff = self:AddInput("Falloff", "Falloff", {
