    })
    InDepthResponse = self:AddInput("Depth Response", "DepthResponse", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 1, INP_MinAllowed = 0.25, INP_MaxAllowed = 4, IC_Visible = false,
    })
    InForegroundAmount = self:AddInput("Foreground Amount", "ForegroundAmount", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 1, INP_MinAllowed = 0, INP_MaxAllowed = 2, IC_Visible = false,
    })
    InBackgroundAmount = self:AddInput("Background Amount", "BackgroundAmount", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 1, INP_MinAllowed = 0, INP_MaxAllowed = 2, IC_Visible = false,
    })

    self:EndControlNest()

    self:AddControlPage("Info")

    InDescription = self:AddInput(DescriptionUI, "Description", {
        LINKID_DataType    = "Text",
        INPID_InputControl = "LabelControl",
