        IC_NoReset         = true,
        BTNCS_Execute      = [=[
            local url = "https://github.com/AbiYasidAlMajid/ACT-Projects"
            bmd.openurl(url)
        ]=],
    })

    InSocials = self:AddInput("Socials", "Socials", {
        LINKID_DataType    = "Number",
        INPID_InputControl = "ButtonControl",
        ICD_Width          = 0.5,
        IC_NoLabel         = true,
        IC_NoReset         = true,
        BTNCS_Execute      = [=[
            local url = "https://linktr.ee/abiyasidalmajid"
            bmd.openurl(url)
        ]=],
    })

    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image",
        LINK_Main       = 1,
    })
    UpdateFocusControls()
end

local function ProcessLegacy(req)
    local SourceImage = InImage:GetValue(req)
    if SourceImage == nil then return end

    local BlurMapImage = InBlurMap:GetValue(req)

    -- Precalculation requests carry image metadata without renderable pixels.
    if req:IsPreCalc() then
        OutImage:Set(req, Image({ IMG_Like = SourceImage, IMG_NoData = true }))
        return
    end

    local NodeProcess
    if BlurMapImage ~= nil then
        NodeProcess = DVIPComputeNode(req, "ACTLnBl_ProcessKernelBM", ACTLnBl_SourceBM, "ACTLnBL_Params", ACTLnBL_Params)
    else
        NodeProcess = DVIPComputeNode(req, "ACTLnBl_ProcessKernel", ACTLnBl_Source, "ACTLnBL_Params", ACTLnBL_Params)
    end

    if not NodeProcess then
        print("ACT Lens Blur: could not create the blur GPU node; returning the source image.")
        OutImage:Set(req, SourceImage)
        return
    end

    local ParamBlock           = NodeProcess:GetParamBlock(ACTLnBL_Params)

    ParamBlock.SrcSize[0]      = SourceImage.DataWindow:Width()
    ParamBlock.SrcSize[1]      = SourceImage.DataWindow:Height()

    ParamBlock.ViewMode        = InViewMode:GetValue(req).Value
    ParamBlock.BlurSize        = InBlurSize:GetValue(req).Value
    ParamBlock.HlThreshold     = InHLThreshold:GetValue(req).Value
    ParamBlock.HlLevel         = InHLLevel:GetValue(req).Value

    local CACenterVal          = InCACenter:GetValue(req)
    ParamBlock.CACenter[0]     = CACenterVal.X
    ParamBlock.CACenter[1]     = CACenterVal.Y
    ParamBlock.CADistance      = InCADistance:GetValue(req).Value
    ParamBlock.CABlend         = InCABlend:GetValue(req).Value
    ParamBlock.CAUseMap        = InCAUseMap:GetValue(req).Value

    ParamBlock.LensType        = InLensType:GetValue(req).Value
    ParamBlock.LensSides       = InLensSides:GetValue(req).Value
    ParamBlock.LensShape       = InLensShape:GetValue(req).Value
    ParamBlock.LensAngle       = InLensAngle:GetValue(req).Value
    ParamBlock.Anamorphism     = InAnamorphism:GetValue(req).Value

    ParamBlock.Method          = InMethod:GetValue(req).Value
    ParamBlock.InvertMap       = InInvertMap:GetValue(req).Value

    ParamBlock.FocusPosition   = (InFocusPos:GetValue(req).Value + 1.0) / 2.0
    ParamBlock.FocalRegion     = InFocalRegion:GetValue(req).Value / 2.0
    ParamBlock.FocusTransition = InFocusTransition:GetValue(req).Value

    NodeProcess:SetParamBlock(ParamBlock)

    local TempDestination = Image({ IMG_Like = SourceImage })

    -- Metal pixel-coordinate samplers require a clamp address mode.
    -- Mirrored repeat prevents the GPU kernel from compiling on macOS.
    NodeProcess:AddSampler("RowSampler", TEX_FILTER_MODE_POINT, TEX_ADDRESS_MODE_CLAMP, TEX_NORMALIZED_COORDS_FALSE)
    NodeProcess:AddInput("SourceImage", SourceImage)

    if BlurMapImage ~= nil then
        NodeProcess:AddInput("BlurMapImage", BlurMapImage)
    end

    NodeProcess:AddOutput("Destination", TempDestination)
    -- A failed GPU session leaves its output unwritten. Never publish it or
    -- feed it to another pass: pooled GPU memory can contain unrelated frames.
    if not NodeProcess:RunSession(req) then
        print("ACT Lens Blur: blur GPU pass failed; returning the source image. See the Fusion Console for GPU errors.")
        OutImage:Set(req, SourceImage)
        return
    end

    -- Most renders do not need the second GPU pass.
    if ParamBlock.ViewMode ~= 0 or math.abs(ParamBlock.CADistance) <= 0.0001 or ParamBlock.CABlend < 2 then
        OutImage:Set(req, TempDestination)
        return
    end

    local DestinationImage = Image({ IMG_Like = SourceImage })
    local NodeCA
    if BlurMapImage ~= nil then
        NodeCA = DVIPComputeNode(req, "ACTLnBl_CAKernelBM", ACTLnBl_SourceBM, "ACTLnBL_Params", ACTLnBL_Params)
    else
        NodeCA = DVIPComputeNode(req, "ACTLnBl_CAKernel", ACTLnBl_Source, "ACTLnBL_Params", ACTLnBL_Params)
    end

    if NodeCA then
        NodeCA:SetParamBlock(ParamBlock)
        NodeCA:AddSampler("RowSampler", TEX_FILTER_MODE_LINEAR, TEX_ADDRESS_MODE_CLAMP, TEX_NORMALIZED_COORDS_FALSE)
        NodeCA:AddInput("SourceImage", TempDestination)

        if BlurMapImage ~= nil then
            NodeCA:AddInput("BlurMapImage", BlurMapImage)
        end

        NodeCA:AddOutput("Destination", DestinationImage)
        if not NodeCA:RunSession(req) then
            print("ACT Lens Blur: chromatic aberration GPU pass failed; returning the blurred image. See the Fusion Console for GPU errors.")
            DestinationImage = TempDestination
        end
    else
        print("ACT Lens Blur: could not create the chromatic aberration GPU node; returning the blurred image.")
        DestinationImage = TempDestination
    end

    OutImage:Set(req, DestinationImage)
end

-- Precompute aperture taps once per request, never per pixel. No frame-dependent
-- jitter: a stationary scene has an identical sampling pattern on every frame.
local function FillApertureTaps(params, count)
    local aspect = 1 + 2 * math.abs(params.Anamorphism)
    params.AspectX = params.Anamorphism > 0 and aspect or 1
    params.AspectY = params.Anamorphism < 0 and aspect or 1
    local sides = math.max(3, params.LensSides)
    local segment = 2 * math.pi / sides
    local angle = params.LensAngle * math.pi / 180
    local function boundary(theta)
        if params.LensType == 0 then return 1 end
        local a = theta + math.pi + angle
        a = a - segment * math.floor(a / segment) - segment / 2
        local polygon = math.cos(a) / math.cos(math.pi / sides)
        return 1 / (polygon * (1 - params.LensShape) + params.LensShape)
    end
    local area = 0
    for i = 0, 1023 do
        local r = boundary((i + 0.5) * 2 * math.pi / 1024)
        area = area + r * r
    end
    params.ApertureArea = math.pi * area / (1024 * params.AspectX * params.AspectY)
    for i = 0, 255 do
        local theta = i * 2.399963229728653
        local b = boundary(theta)
        local r = math.sqrt((i + 0.5) / math.max(count, 1))
        params.TapX[i] = math.cos(theta) * r * b / params.AspectX
        params.TapY[i] = math.sin(theta) * r * b / params.AspectY
        params.TapWeight[i] = math.pi * b * b / (params.AspectX * params.AspectY * params.ApertureArea)
    end
end

local function FloatImage(width, height)
    return Image({ IMG_Document = self.Comp, IMG_Width = width, IMG_Height = height,
        IMG_Depth = IMDP_128bitFloat, IMG_ProxyScale = 1,
        { IMG_Channel = "Red" }, { IMG_Channel = "Green" },
        { IMG_Channel = "Blue" }, { IMG_Channel = "Alpha" },
    })
end

local function RunRelativePass(req, kernel, params, inputs, destination)
    local node = DVIPComputeNode(req, kernel, ACTLnBl_RelativeSource, "ACTLnBL_Params", ACTLnBL_Params)
    if not node then return false end
    node:SetParamBlock(params)
    node:AddSampler("RowSampler", TEX_FILTER_MODE_LINEAR, TEX_ADDRESS_MODE_CLAMP, TEX_NORMALIZED_COORDS_FALSE)
    for _, input in ipairs(inputs) do node:AddInput(input[1], input[2]) end
    node:AddOutput("Destination", destination)
    if not node:RunSession(req) then
        print("ACT Lens Blur: " .. kernel .. " failed. See the Fusion Console for GPU errors.")
        return false
    end
    return true
end

function Process(req)
    local method = InMethod:GetValue(req).Value
    local quality = InQuality:GetValue(req).Value
    local view = InViewMode:GetValue(req).Value
    if method ~= 3 and quality == 0 and view ~= 3 then
        return ProcessLegacy(req)
    end
    local source = InImage:GetValue(req)
    if not source then return end
    if req:IsPreCalc() then
        OutImage:Set(req, Image({ IMG_Like = source, IMG_NoData = true }))
        return
    end
    local map = InBlurMap:GetValue(req)
    if method == 3 and not map then
        print("ACT Lens Blur: Relative Depth needs a grayscale map connected to Blur Map.")
        OutImage:Set(req, source)
        return
    end
    local width = source.DataWindow:Width()
    local height = source.DataWindow:Height()
    if width <= 0 or height <= 0 or (map and (map.DataWindow:Width() <= 0 or map.DataWindow:Height() <= 0)) then
        OutImage:Set(req, source)
        return
    end
    -- Use this node's native parameter layout, as in the original DVIP path.
    local setup = DVIPComputeNode(req, "ACTLnBl_FastKernel", ACTLnBl_RelativeSource, "ACTLnBL_Params", ACTLnBL_Params)
    if not setup then OutImage:Set(req, source); return end
    local params = setup:GetParamBlock(ACTLnBL_Params)
    params.SrcSize[0], params.SrcSize[1] = width, height
    params.SrcOrigin[0], params.SrcOrigin[1] = source.DataWindow.left, source.DataWindow.bottom
    params.SrcFullSize[0], params.SrcFullSize[1] = source.Width, source.Height
    local mapSource = map or source
    params.MapSize[0], params.MapSize[1] = mapSource.DataWindow:Width(), mapSource.DataWindow:Height()
    params.MapOrigin[0], params.MapOrigin[1] = mapSource.DataWindow.left, mapSource.DataWindow.bottom
    params.MapFullSize[0], params.MapFullSize[1] = mapSource.Width, mapSource.Height
    params.ViewMode = view
    params.BlurSize = math.max(0, InBlurSize:GetValue(req).Value)
    params.HlThreshold = InHLThreshold:GetValue(req).Value
    params.HlLevel = InHLLevel:GetValue(req).Value
    local ca = InCACenter:GetValue(req)
    params.CACenter[0], params.CACenter[1] = ca.X, ca.Y
    params.CADistance = InCADistance:GetValue(req).Value
    params.CABlend = InCABlend:GetValue(req).Value
    params.CAUseMap = InCAUseMap:GetValue(req).Value
    params.LensType = InLensType:GetValue(req).Value
    params.LensSides = math.max(3, InLensSides:GetValue(req).Value)
    params.LensShape = InLensShape:GetValue(req).Value
    params.LensAngle = InLensAngle:GetValue(req).Value
    params.Anamorphism = InAnamorphism:GetValue(req).Value
    params.Method = map and method or 0
    params.InvertMap = InInvertMap:GetValue(req).Value
    params.FocusPosition = (InFocusPos:GetValue(req).Value + 1) / 2
    params.FocalRegion = InFocalRegion:GetValue(req).Value / 2
    params.FocusTransition = InFocusTransition:GetValue(req).Value
    params.FocusSource = InFocusSource:GetValue(req).Value
    local point = InFocusPoint:GetValue(req)
    params.FocusPoint[0], params.FocusPoint[1] = point.X, point.Y
    params.ManualFocus = InManualFocus:GetValue(req).Value
    params.SampleArea = math.max(0, math.min(8, math.floor(InSampleArea:GetValue(req).Value)))
    params.NearWhite = InNearWhite:GetValue(req).Value
    params.SharpRange = InSharpRange:GetValue(req).Value
    params.Falloff = InFalloff:GetValue(req).Value
    params.DepthResponse = InDepthResponse:GetValue(req).Value
    params.ForegroundAmount = InForegroundAmount:GetValue(req).Value
    params.BackgroundAmount = InBackgroundAmount:GetValue(req).Value
    params.Samples = ({ [0] = 0, 32, 96, 256 })[quality] or 96
    FillApertureTaps(params, params.Samples)
    local focus = source -- A bound dummy texture when no focus sampling is required.
    if method == 3 and params.FocusSource == 1 then
        focus = FloatImage(1, 1)
        if not RunRelativePass(req, "ACTLnBl_FocusKernel", params, {{"BlurMapImage", map}}, focus) then
            OutImage:Set(req, source); return
        end
    end
    local prepared = FloatImage(width, height)
    if not RunRelativePass(req, "ACTLnBl_PrepareKernel", params,
        {{"BlurMapImage", mapSource}, {"FocusImage", focus}}, prepared) then
        OutImage:Set(req, source); return
    end
    local blurred = Image({ IMG_Like = source })
    if not RunRelativePass(req, "ACTLnBl_FastKernel", params,
        {{"SourceImage", source}, {"PreparedMap", prepared}}, blurred) then
        OutImage:Set(req, source); return
    end
    if view ~= 0 or math.abs(params.CADistance) <= 0.0001 or params.CABlend < 2 then
        OutImage:Set(req, blurred); return
    end
    local destination = Image({ IMG_Like = source })
    if not RunRelativePass(req, "ACTLnBl_CAFastKernel", params,
        {{"SourceImage", blurred}, {"PreparedMap", prepared}}, destination) then
        destination = blurred
    end
    OutImage:Set(req, destination)
end
