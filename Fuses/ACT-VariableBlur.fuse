local FuseName = "Variable Blur"
local FuseVersion = "1.0"
local FuseAuthor = "Abi Yasid Al'Majid"
local FuseDescription = "A Gaussian blur filter that supports blur map input to enable variable blur distribution across the image."

FuRegisterClass("VariableBlur", CT_Tool, {
    REGS_Name = FuseName,
    REGS_Category = "ACTProjects\\Blur",
    REGS_OpIconString = "ACT-VrBl",
    REGS_OpDescription = "A Gaussian blur filter that supports blur map input to enable variable blur distribution across the image",
    REG_NoObjMatCtrls = true,
    REG_NoMotionBlurCtrls = true,
    REG_Fuse_NoEdit = true,
    REG_Fuse_NoReload = true,
    REG_Version = 1.0,
})

ACTVrBl_BlurPassParams = [[
    int SrcSize[2];
    int BlurSize;
]]

ACTVrBl_BlurHSource = [[
    __KERNEL__ void ACTVrBl_BlurHKernel(__CONSTANTREF__ ACTVrBl_BlurPassParams *Params, __TEXTURE2D__ SourceImage, __TEXTURE2D_WRITE__ Destination)
    {
        DEFINE_KERNEL_ITERATORS_XY(x, y)
        int Width = Params->SrcSize[0];
        int Height = Params->SrcSize[1];

        if (x >= Width || y >= Height) return;

        int Radius = Params->BlurSize;
        float Sigma = (float)Radius / 3.0f;
        if (Sigma < 0.1f) Sigma = 0.1f;

        float InvTwoSigmaSq = 1.0f / (2.0f * Sigma * Sigma);

        float4 SumColor;
        SumColor.x = 0.0f;
        SumColor.y = 0.0f;
        SumColor.z = 0.0f;
        SumColor.w = 0.0f;
        float WeightSum = 0.0f;

        for (int i = -Radius; i <= Radius; i++) {
            int SampleX = x + i;
            SampleX = SampleX < 0 ? 0 : (SampleX >= Width ? Width - 1 : SampleX);

            float4 SampleColor = _tex2DVecN(SourceImage, SampleX, y, 15);
            float Weight = _expf(-(float)(i*i) * InvTwoSigmaSq);

            SumColor.x += SampleColor.x * Weight;
            SumColor.y += SampleColor.y * Weight;
            SumColor.z += SampleColor.z * Weight;
            SumColor.w += SampleColor.w * Weight;
            WeightSum += Weight;
        }

        if (WeightSum > 0.0f) {
            SumColor.x /= WeightSum;
            SumColor.y /= WeightSum;
            SumColor.z /= WeightSum;
            SumColor.w /= WeightSum;
        }

        _tex2DVec4Write(Destination, x, y, SumColor);
    }
]]

ACTVrBl_BlurVSource = [[
    __KERNEL__ void ACTVrBl_BlurVKernel(__CONSTANTREF__ ACTVrBl_BlurPassParams *Params, __TEXTURE2D__ SourceImage, __TEXTURE2D_WRITE__ Destination)
    {
        DEFINE_KERNEL_ITERATORS_XY(x, y)
        int Width = Params->SrcSize[0];
        int Height = Params->SrcSize[1];

        if (x >= Width || y >= Height) return;

        int Radius = Params->BlurSize;
        float Sigma = (float)Radius / 3.0f;
        if (Sigma < 0.1f) Sigma = 0.1f;

        float InvTwoSigmaSq = 1.0f / (2.0f * Sigma * Sigma);

        float4 SumColor;
        SumColor.x = 0.0f;
        SumColor.y = 0.0f;
        SumColor.z = 0.0f;
        SumColor.w = 0.0f;
        float WeightSum = 0.0f;

        for (int j = -Radius; j <= Radius; j++) {
            int SampleY = y + j;
            SampleY = SampleY < 0 ? 0 : (SampleY >= Height ? Height - 1 : SampleY);

            float4 SampleColor = _tex2DVecN(SourceImage, x, SampleY, 15);
            float Weight = _expf(-(float)(j*j) * InvTwoSigmaSq);

            SumColor.x += SampleColor.x * Weight;
            SumColor.y += SampleColor.y * Weight;
            SumColor.z += SampleColor.z * Weight;
            SumColor.w += SampleColor.w * Weight;
            WeightSum += Weight;
        }

        if (WeightSum > 0.0f) {
            SumColor.x /= WeightSum;
            SumColor.y /= WeightSum;
            SumColor.z /= WeightSum;
            SumColor.w /= WeightSum;
        }

        _tex2DVec4Write(Destination, x, y, SumColor);
    }
]]

ACTVrBl_BlurHBMSource = [[
    __KERNEL__ void ACTVrBl_BlurHKernelBM(__CONSTANTREF__ ACTVrBl_BlurPassParams *Params, __TEXTURE2D__ SourceImage, __TEXTURE2D__ BlurMapImage, __TEXTURE2D_WRITE__ Destination)
    {
        DEFINE_KERNEL_ITERATORS_XY(x, y)
        int Width = Params->SrcSize[0];
        int Height = Params->SrcSize[1];

        if (x >= Width || y >= Height) return;

        float4 CenterColor = _tex2DVecN(SourceImage, x, y, 15);

        float Luminance = _tex2DVecN(BlurMapImage, x, y, 1).x;
        Luminance = Luminance < 0.0f ? 0.0f : (Luminance > 1.0f ? 1.0f : Luminance);

        int Radius = (int)_ceilf((float)Params->BlurSize * Luminance);

        if (Radius < 1) {
            _tex2DVec4Write(Destination, x, y, CenterColor);
            return;
        }

        float Sigma = (float)Radius / 3.0f;
        if (Sigma < 0.1f) Sigma = 0.1f;

        float InvTwoSigmaSq = 1.0f / (2.0f * Sigma * Sigma);

        float4 SumColor;
        SumColor.x = 0.0f;
        SumColor.y = 0.0f;
        SumColor.z = 0.0f;
        SumColor.w = 0.0f;
        float WeightSum = 0.0f;

        for (int i = -Radius; i <= Radius; i++) {
            int SampleX = x + i;
            SampleX = SampleX < 0 ? 0 : (SampleX >= Width ? Width - 1 : SampleX);

            float4 SampleColor = _tex2DVecN(SourceImage, SampleX, y, 15);

            float BlurMapWeight = _tex2DVecN(BlurMapImage, SampleX, y, 1).x;
            BlurMapWeight = BlurMapWeight < 0.0f ? 0.0f : (BlurMapWeight > 1.0f ? 1.0f : BlurMapWeight);

            float Weight = _expf(-(float)(i*i) * InvTwoSigmaSq) * BlurMapWeight;

            SumColor.x += SampleColor.x * Weight;
            SumColor.y += SampleColor.y * Weight;
            SumColor.z += SampleColor.z * Weight;
            SumColor.w += SampleColor.w * Weight;
            WeightSum += Weight;
        }

        if (WeightSum > 0.0f) {
            SumColor.x /= WeightSum;
            SumColor.y /= WeightSum;
            SumColor.z /= WeightSum;
            SumColor.w /= WeightSum;
        } else {
            SumColor = CenterColor;
        }

        _tex2DVec4Write(Destination, x, y, SumColor);
    }
]]

ACTVrBl_BlurVBMSource = [[
    __KERNEL__ void ACTVrBl_BlurVKernelBM(__CONSTANTREF__ ACTVrBl_BlurPassParams *Params, __TEXTURE2D__ SourceImage, __TEXTURE2D__ BlurMapImage, __TEXTURE2D_WRITE__ Destination)
    {
        DEFINE_KERNEL_ITERATORS_XY(x, y)
        int Width = Params->SrcSize[0];
        int Height = Params->SrcSize[1];

        if (x >= Width || y >= Height) return;

        float4 CenterColor = _tex2DVecN(SourceImage, x, y, 15);

        float Luminance = _tex2DVecN(BlurMapImage, x, y, 1).x;
        Luminance = Luminance < 0.0f ? 0.0f : (Luminance > 1.0f ? 1.0f : Luminance);

        int Radius = (int)_ceilf((float)Params->BlurSize * Luminance);

        if (Radius < 1) {
            _tex2DVec4Write(Destination, x, y, CenterColor);
            return;
        }

        float Sigma = (float)Radius / 3.0f;
        if (Sigma < 0.1f) Sigma = 0.1f;

        float InvTwoSigmaSq = 1.0f / (2.0f * Sigma * Sigma);

        float4 SumColor;
        SumColor.x = 0.0f;
        SumColor.y = 0.0f;
        SumColor.z = 0.0f;
        SumColor.w = 0.0f;
        float WeightSum = 0.0f;

        for (int j = -Radius; j <= Radius; j++) {
            int SampleY = y + j;
            SampleY = SampleY < 0 ? 0 : (SampleY >= Height ? Height - 1 : SampleY);

            float4 SampleColor = _tex2DVecN(SourceImage, x, SampleY, 15);

            float BlurMapWeight = _tex2DVecN(BlurMapImage, x, SampleY, 1).x;
            BlurMapWeight = BlurMapWeight < 0.0f ? 0.0f : (BlurMapWeight > 1.0f ? 1.0f : BlurMapWeight);

            float Weight = _expf(-(float)(j*j) * InvTwoSigmaSq) * BlurMapWeight;

            SumColor.x += SampleColor.x * Weight;
            SumColor.y += SampleColor.y * Weight;
            SumColor.z += SampleColor.z * Weight;
            SumColor.w += SampleColor.w * Weight;
            WeightSum += Weight;
        }

        if (WeightSum > 0.0f) {
            SumColor.x /= WeightSum;
            SumColor.y /= WeightSum;
            SumColor.z /= WeightSum;
            SumColor.w /= WeightSum;
        } else {
            SumColor = CenterColor;
        }

        _tex2DVec4Write(Destination, x, y, SumColor);
    }
]]

ACTLogo = [[
    <center><img width="300" src='data:image/png;base64, '></center>
]]

local VersionUI = string.format([[
    <center><b>%s v%s</b></center>
]], FuseName, FuseVersion)

local DescriptionUI = string.format([[
    <h3 style="line-height: 0.5;" >ACT %s</h3>
    <p>Version %s | By %s</p>
    <p>%s</p>
    <br>
]], FuseName, FuseVersion, FuseAuthor, FuseDescription)

function Create()
    InImage = self:AddInput("Image", "Input", {
        LINKID_DataType = "Image",
        LINK_Main       = 1,
    })

    InBlurMap = self:AddInput("Blur Map", "BlurMap", {
        LINKID_DataType = "Image",
        LINK_Main       = 2,
        INP_Required    = false,
    })

    InLogo = self:AddInput(ACTLogo, "Logo", {
        LINKID_DataType    = "Text",
        INPID_InputControl = "LabelControl",
        INP_External       = false,
        INP_Passive        = true,
        IC_ControlPage     = -1,
        IC_NoLabel         = true,
        IC_NoReset         = true,
        LBLC_MultiLine     = true,
    })

    InVersion = self:AddInput(VersionUI, "Version", {
        LINKID_DataType    = "Text",
        INPID_InputControl = "LabelControl",
        INP_External       = false,
        INP_Passive        = true,
        IC_ControlPage     = -1,
        IC_NoLabel         = true,
        IC_NoReset         = true,
        LBLC_MultiLine     = true,
    })

    InBlurSize = self:AddInput("Blur Size", "BlurSize", {
        LINKID_DataType    = "Number",
        INPID_InputControl = "SliderControl",
        INP_Integer        = true,
        INP_Default        = 10.0,
        INP_MinAllowed     = 0.0,
        INP_MaxScale       = 100.0,
    })

    self:AddControlPage("Info")

    InDescription = self:AddInput(DescriptionUI, "Description", {
        LINKID_DataType    = "Text",
        INPID_InputControl = "LabelControl",
        INP_External       = false,
        INP_Passive        = true,
        IC_NoLabel         = true,
        IC_NoReset         = true,
        LBLC_MultiLine     = true,
    })

    InRepository = self:AddInput("ACT Projects Repository", "ACTRepository", {
        LINKID_DataType    = "Number",
        INPID_InputControl = "ButtonControl",
        ICD_Width          = 0.5,
        IC_NoLabel         = true,
        IC_NoReset         = true,
        BTNCS_Execute      = [=[
            local url = "https://github.com/AbiYasidAlMajid/ACT-Projects"
            bmd.openurl(url)
        ]=],
    })

    InSocials = self:AddInput("Socials", "Socials", {
        LINKID_DataType    = "Number",
        INPID_InputControl = "ButtonControl",
        ICD_Width          = 0.5,
        IC_NoLabel         = true,
        IC_NoReset         = true,
        BTNCS_Execute      = [=[
            local url = "https://linktr.ee/abiyasidalmajid"
            bmd.openurl(url)
        ]=],
    })

    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image",
        LINK_Main       = 1,
    })
end

function Process(req)
    local SourceImage = InImage:GetValue(req)
    if SourceImage == nil then return end

    local BlurMapImage = InBlurMap:GetValue(req)
    local BlurSizeValue = InBlurSize:GetValue(req).Value

    if BlurSizeValue < 1 then
        OutImage:Set(req, SourceImage)
        return
    end

    local ImageWidth = SourceImage.DataWindow:Width()
    local ImageHeight = SourceImage.DataWindow:Height()

    -- PASS 1: Horizontal Blur
    local BlurHorizontal = Image({ IMG_Like = SourceImage })
    local NodeHorizontal

    if BlurMapImage ~= nil then
        NodeHorizontal = DVIPComputeNode(req, "ACTVrBl_BlurHKernelBM", ACTVrBl_BlurHBMSource, "ACTVrBl_BlurPassParams", ACTVrBl_BlurPassParams)
    else
        NodeHorizontal = DVIPComputeNode(req, "ACTVrBl_BlurHKernel", ACTVrBl_BlurHSource, "ACTVrBl_BlurPassParams", ACTVrBl_BlurPassParams)
    end

    if NodeHorizontal == nil then
        OutImage:Set(req, SourceImage)
        return
    end

    do
        local ParamBlock = NodeHorizontal:GetParamBlock(ACTVrBl_BlurPassParams)
        ParamBlock.SrcSize[0] = ImageWidth
        ParamBlock.SrcSize[1] = ImageHeight
        ParamBlock.BlurSize = BlurSizeValue

        NodeHorizontal:SetParamBlock(ParamBlock)
        NodeHorizontal:AddInput("SourceImage", SourceImage)

        if BlurMapImage ~= nil then
            NodeHorizontal:AddInput("BlurMapImage", BlurMapImage)
        end

        NodeHorizontal:AddOutput("Destination", BlurHorizontal)
        NodeHorizontal:RunSession(req)
    end

    -- PASS 2: Vertical Blur
    local DestinationImage = Image({ IMG_Like = SourceImage })
    local NodeVertical

    if BlurMapImage ~= nil then
        NodeVertical = DVIPComputeNode(req, "ACTVrBl_BlurVKernelBM", ACTVrBl_BlurVBMSource, "ACTVrBl_BlurPassParams", ACTVrBl_BlurPassParams)
    else
        NodeVertical = DVIPComputeNode(req, "ACTVrBl_BlurVKernel", ACTVrBl_BlurVSource, "ACTVrBl_BlurPassParams", ACTVrBl_BlurPassParams)
    end

    if NodeVertical == nil then
        OutImage:Set(req, BlurHorizontal)
        return
    end

    do
        local ParamBlock = NodeVertical:GetParamBlock(ACTVrBl_BlurPassParams)
        ParamBlock.SrcSize[0] = ImageWidth
        ParamBlock.SrcSize[1] = ImageHeight
        ParamBlock.BlurSize = BlurSizeValue

        NodeVertical:SetParamBlock(ParamBlock)
        NodeVertical:AddInput("SourceImage", BlurHorizontal)

        if BlurMapImage ~= nil then
            NodeVertical:AddInput("BlurMapImage", BlurMapImage)
        end

        NodeVertical:AddOutput("Destination", DestinationImage)
        NodeVertical:RunSession(req)
    end

    OutImage:Set(req, DestinationImage)
end